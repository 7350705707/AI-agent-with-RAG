# Copy this file to  .env  and edit the values for your deployment.
# docker-compose.yml reads these automatically.

# ── LM Studio ──────────────────────────────────────────────────────────────
# URL where LM Studio's OpenAI-compatible API is listening.
# Docker Desktop (Windows/Mac): use host.docker.internal
# Bare Linux Docker:            use the host's LAN IP, e.g. 192.168.1.10
LM_STUDIO_BASE_URL=http://host.docker.internal:1234/v1

# The model ID as it appears in LM Studio (must be loaded in LM Studio first)
LLM_MODEL=nemotron-3-nano-4b

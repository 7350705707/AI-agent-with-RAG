# Version control
.git
.gitignore
.gitattributes

# Editor / IDE
.vscode
*.code-workspace

# Documentation
*.md
!backend/requirements.txt

# Frontend — exclude heavy directories that are rebuilt inside Docker
frontend/node_modules
frontend/.vite
frontend/dist

# Backend — exclude runtime-generated & dev-only files
backend/__pycache__
backend/**/__pycache__
backend/*.pyc
backend/**/*.pyc
backend/packages/
backend/logs/
backend/chroma_db/
backend/uploads/
backend/knowledge_files/
backend/faiss_index/
backend/chat_history.db
backend/.jwt_secret
backend/test_upload.txt

# Deployment / scripts (not needed in image)
deployment/
*.ps1
*.tar
*.zip

# Docker files themselves (no infinite recursion)
Dockerfile
docker-compose.yml
.dockerignore
